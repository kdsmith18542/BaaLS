baals.online, www.baals.online {
    encode zstd gzip
    root * /var/www/baals/web
    file_server

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        Content-Security-Policy "default-src 'self'; connect-src 'self' https: wss: http://127.0.0.1:8080 ws://127.0.0.1:8081; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; img-src 'self' data:;"
    }

    handle_path /api/* {
        reverse_proxy 127.0.0.1:8080
    }

    handle /auth/token {
        reverse_proxy 127.0.0.1:8080
    }

    handle /ws* {
        reverse_proxy 127.0.0.1:8081
    }

    try_files {path} /index.html
}
