# Copy to /etc/default/baals-monitor to configure alert delivery for /etc/baals/monitor.sh
# Example:
#   sudo cp scripts/baals-monitor.env.example /etc/default/baals-monitor
#   sudo chmod 600 /etc/default/baals-monitor

# Optional: webhook target for alert/recovery JSON payloads.
# BAALS_MONITOR_WEBHOOK_URL="https://hooks.example.com/baals"

# Optional: recipient email address for alerts/recoveries (requires mail or mailx).
# BAALS_MONITOR_EMAIL_TO="ops@example.com"

# Optional: custom email subject prefix.
# BAALS_MONITOR_EMAIL_SUBJECT_PREFIX="[BaaLS Prod]"

# Optional: suppress repeated identical alerts within this window (seconds).
# BAALS_MONITOR_ALERT_COOLDOWN_SECONDS=900

# Optional: state directory for alert dedupe and recovery tracking.
# BAALS_MONITOR_STATE_DIR="/var/lib/baals-monitor"
